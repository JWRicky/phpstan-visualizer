{
    "name": "jwricky/phpstan-visualizer",
    "description": "A beautiful Xcode-style visualizer for PHPStan reports.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "JWRicky",
            "email": "stereorick@gmail.com"
        }
    ],
    "require": {
